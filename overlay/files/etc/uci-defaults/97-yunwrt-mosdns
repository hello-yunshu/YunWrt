#!/bin/sh
# 首次启动把 mosdns 拉到可用状态，并确保走上游配置生成器。
#
# luci-app-mosdns 的图形界面只对 /var/etc/mosdns.json 生效：basic.js 里几乎所有
# 开关都 depends('configfile','/var/etc/mosdns.json')。选另一个取值时界面会只剩
# 一个 YAML 编辑器，所有开关全部隐藏——这正是之前"在 LuCI 里配了却不生效"的由来。
#
# 那份 JSON 含 log.size 与 stats_api，只有配套补丁版 mosdns 才认。本镜像从自有
# feed 装的就是配套版，由 scripts/check-mosdns-config.sh 在构建期守住；装错版本
# 会在这里 restart 失败并 exit 1，而不是悄悄跑在残废配置上。
set -e

[ -f /etc/config/mosdns ] || { echo "ERROR: /etc/config/mosdns missing（luci-app-mosdns 未安装）" >&2; exit 1; }
[ -x /etc/init.d/mosdns ] || { echo "ERROR: /etc/init.d/mosdns missing（mosdns 未安装）" >&2; exit 1; }

uci -q batch <<'EOF'
set mosdns.config.enabled='1'
set mosdns.config.configfile='/var/etc/mosdns.json'
# 953 是 openclash-dns-guard 的兜底端口，也是 OpenClash 指向 mosdns 的地址；
# 上游默认是 0.0.0.0:5335，改掉它会让整条 DNS 链断掉。
# 只监听回环：DNS 劫持由 dnsmasq + OpenClash 负责，mosdns 只做兜底上游。
set mosdns.config.listen_address='127.0.0.1'
set mosdns.config.listen_port='953'
set mosdns.config.redirect='0'
# 上游默认 remote_dns 是 tls://8.8.8.8。这条线路上 853 会被中断（SYN 无响应或
# 握手后单向 EOF），留着只会让"国外域名"那条分支卡到超时。换成国内可用 DoH。
set mosdns.config.remote_dns='https://dns.alidns.com/dns-query'
# 广告拦截走 adblock_set 插件，规则清单要联网下载写进 /etc/mosdns/rule。
# 默认关闭，需要时在 LuCI 里打开即可——这才是"开关真的生效"。
set mosdns.config.adblock='0'
set mosdns.config.geo_auto_update='0'
EOF
uci -q commit mosdns

# 回读确认：commit 失败不会体现在 restart 的返回码里。
[ "$(uci -q get mosdns.config.configfile)" = "/var/etc/mosdns.json" ] || {
	echo "ERROR: configfile 回读非 /var/etc/mosdns.json" >&2
	exit 1
}
[ "$(uci -q get mosdns.config.listen_port)" = "953" ] || {
	echo "ERROR: listen_port 回读非 953" >&2
	exit 1
}

/etc/init.d/mosdns enable
# 这一步会调用生成器写出 /var/etc/mosdns.json 再启动。二进制不配套就会在这里
# 失败，脚本保留下来下轮重试，不会静默放过。
/etc/init.d/mosdns restart || {
	echo "ERROR: mosdns 启动失败（配置生成或二进制不配套）" >&2
	exit 1
}

exit 0
