#!/bin/sh
# D13（修订）：LuCI 管理面只走明文 http，彻底消除浏览器的 https 自动升级。
#
# —— 旧版为什么没解决用户看到的「跳转」 ——
#   旧版只删了 _redirect2ssl 的 302、把 80 挂到 _lan，443 照旧监听。
#   但用户遇到的「自动跳 https」根本不是服务端 302：
#   Edge / Chrome 的 HTTPS-Upgrades 在发请求之前就先把 http 升级成 https，
#   443 上挂的是自签证书（nginx._lan.uci_manage_ssl='self-signed'），
#   点过一次「继续前往」之后浏览器就一路 https —— 显式敲 http:// 也拦不住。
#   只要 443 还在监听，「取消 302」就是白做。
#
# —— 旧版还有一处假成功 ——
#   regen_and_test() 里 `rm -f "$(readlink "${UCI_CONF}")"`：
#   /etc/nginx/uci.conf 是普通文件而不是符号链接，readlink 返回空串，
#   `rm -f ""` 什么都没删掉；而实测 nginx-util init_lan 也根本不会重建这个文件
#   （把 uci.conf 移走后再跑 init_lan，它不会重新生成）。
#   于是 uci 改了、nginx -t 过了、exit 0 了，但 nginx 实际加载的配置文件
#   一个字节都没变 —— 日志报「已取消」，用户那边照样跳 https。
#
# —— 现在的做法 ——
#   1. UCI 与 "${UCI_CONF}" 双写：后者才是 nginx -c 真正加载的文件，必须直接改
#   2. 删掉 _redirect2ssl 段，_lan 只监听 80，不再保留任何 ssl 监听
#   3. 443 无人监听 → 浏览器升级 https 立刻连接失败 → 静默回退到 http
#
# 代价：不再提供 https 管理入口。内网 + 自签证书的前提下，强制 https 本来就
# 换不来真正的机密性（每次都要点「继续前往」），这是刻意的取舍。
#
# 两处非 0 退出是刻意的（沿用本目录既有约定）：uci-defaults 成功即被删除，
# 静默 exit 0 会让「overlay 没生效」看起来像成功。

die() {
	echo "ERROR: $*" >&2
	logger -t nginx-http -p daemon.err "ERROR: $*"
	exit 1
}

[ -x /usr/sbin/nginx ] || die "nginx 未安装"

eval "$(/usr/bin/nginx-util get_env 2>/dev/null)" || die "nginx-util get_env 失败"
[ -n "${LAN_NAME:-}" ] || die "get_env 未给出 LAN_NAME"
[ -n "${UCI_CONF:-}" ] || die "get_env 未给出 UCI_CONF"
[ -f "${UCI_CONF}" ] || die "找不到 ${UCI_CONF}（nginx 配置未生成？）"

SEC="nginx.${LAN_NAME}"
uci -q get "${SEC}" >/dev/null 2>&1 || die "uci 缺少 server 段 ${SEC}"

BAK_UCI="$(mktemp /tmp/nginx.config.XXXXXX)" || die "无法创建备份"
BAK_CONF="$(mktemp /tmp/nginx.uciconf.XXXXXX)" || die "无法创建备份"
cp /etc/config/nginx "${BAK_UCI}" || die "备份 /etc/config/nginx 失败"
cp "${UCI_CONF}" "${BAK_CONF}" || die "备份 ${UCI_CONF} 失败"

restore() {
	cp "${BAK_UCI}" /etc/config/nginx
	uci commit nginx >/dev/null 2>&1
	cp "${BAK_CONF}" "${UCI_CONF}"
	rm -f "${BAK_UCI}" "${BAK_CONF}"
}

# --- 1. UCI 侧 ---
# 1a. 去掉 302 强跳段（段名来自 nginx-util 的 nginx.config，固定不变量）
uci -q delete nginx._redirect2ssl

# 1b. _lan 只保留明文 80；整体删除再重建，保证幂等
uci -q delete "${SEC}.listen"
uci add_list "${SEC}.listen=80"
uci add_list "${SEC}.listen=[::]:80"

uci commit nginx || { restore; die "uci commit nginx 失败，已还原"; }

# --- 2. "${UCI_CONF}" 侧（nginx 真正读的文件）---
# 2a. 443 ssl -> 80（保留 ssl_certificate 行无害：listen 无 ssl 时 nginx 会忽略）
if grep -q 'listen 443' "${UCI_CONF}"; then
	sed -i \
		-e 's/listen 443 ssl default_server;/listen 80;/' \
		-e 's/listen \[::\]:443 ssl default_server;/listen [::]:80;/' \
		-e 's/listen 443 ssl;/listen 80;/' \
		-e 's/listen \[::\]:443 ssl;/listen [::]:80;/' \
		"${UCI_CONF}"
fi

# 2b. 删掉 _redirect2ssl 段，否则它和 _lan 抢同一个 80
if grep -q "see uci show 'nginx._redirect2ssl'" "${UCI_CONF}"; then
	awk '
		/see uci show .nginx\._redirect2ssl/ { skip = 1 }
		skip && /^\t\}$/ { skip = 0; next }
		!skip { print }
	' "${UCI_CONF}" > "${UCI_CONF}.new" || { restore; die "裁剪 _redirect2ssl 段失败"; }
	mv "${UCI_CONF}.new" "${UCI_CONF}"
fi

# --- 3. 校验：语法必须过，且不能残留在监听 443 ---
if ! /usr/sbin/nginx -t -c "${UCI_CONF}" -g 'daemon off;' >/dev/null 2>&1; then
	restore
	die "改后 nginx -t 不通过，已回滚"
fi

if grep -qE '^\s*listen .*443' "${UCI_CONF}"; then
	restore
	die "${UCI_CONF} 里仍有监听 443（上游配置格式可能变了），已回滚"
fi

rm -f "${BAK_UCI}" "${BAK_CONF}"

# 已在运行就平滑重载；未运行则开机 start 时读到的就是新配置
if [ -f /var/run/nginx.pid ]; then
	/etc/init.d/nginx reload >/dev/null 2>&1 ||
		/etc/init.d/nginx restart >/dev/null 2>&1 ||
		die "nginx 重载失败"
fi

logger -t nginx-http "LuCI 仅明文 http：${LAN_NAME} 只监听 80，443 不再监听（浏览器不会再自动升级 https）"
exit 0
