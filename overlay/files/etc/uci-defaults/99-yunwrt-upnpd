#!/bin/sh
# 首次启动把 UPnP 与 NAT 中继修到"可判定可用"的状态。
# 设备历史问题是：upnp_nat_relay 处于 enabled 但未运行，miniupnpd 根本没装。
# 这里只做启用与启动，不改具体转发规则；规则由 patch 层与自研包负责。

die() {
	echo "ERROR: $*" >&2
	exit 1
}

# 静默 exit 0 会让"miniupnpd 没装 / overlay 没生效"看起来像成功：
# uci-defaults 成功后会被删掉，下一轮没人再试，症状是 UPnP 悄悄不可用。
[ -f /etc/config/upnpd ] || die "/etc/config/upnpd 缺失（miniupnpd 未安装或 overlay 未进镜像）"

uci -q batch <<EOF
set upnpd.@upnpd[0].enabled='1'
set upnpd.@upnpd[0].ext_allow_private_ipv4='1'
EOF
uci -q commit upnpd

# 回读确认：commit 失败时脚本会被删掉且没人知道，症状是「跑了但没生效」。
[ "$(uci -q get upnpd.@upnpd[0].enabled)" = "1" ] || die "upnpd.enabled 回读非 1"
[ "$(uci -q get upnpd.@upnpd[0].ext_allow_private_ipv4)" = "1" ] || die "upnpd.ext_allow_private_ipv4 回读非 1"

if [ -x /etc/init.d/miniupnpd ]; then
	/etc/init.d/miniupnpd enable
	/etc/init.d/miniupnpd restart || echo "WARNING: miniupnpd restart 返回非 0（可能 WAN 未就绪，由 procd 重试）" >&2
else
	echo "WARNING: /etc/init.d/miniupnpd 不存在，UPnP 端口映射不可用" >&2
fi

if [ -x /etc/init.d/upnp_nat_relay ]; then
	# 这个服务的 init 第一句就是 config_get_bool enabled main enabled 0，
	# 出厂 config 是 enabled '0' —— 只 enable 不打开开关，永远起不来。
	[ -f /etc/config/upnp_nat_relay ] || die "/etc/config/upnp_nat_relay 缺失"
	uci -q set upnp_nat_relay.main.enabled='1'
	uci -q commit upnp_nat_relay
	[ "$(uci -q get upnp_nat_relay.main.enabled)" = "1" ] || die "upnp_nat_relay.enabled 回读非 1"
	/etc/init.d/upnp_nat_relay enable
	/etc/init.d/upnp_nat_relay restart || echo "WARNING: upnp_nat_relay restart 返回非 0，由 procd 重试" >&2
else
	echo "WARNING: /etc/init.d/upnp_nat_relay 不存在，NAT 中继不可用" >&2
fi

exit 0
