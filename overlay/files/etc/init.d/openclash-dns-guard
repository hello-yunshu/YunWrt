#!/bin/sh /etc/rc.common
# OpenClash DNS guard: keeps DNS alive when the clash core (653) is dead.
# Does not modify any OpenClash package file.

START=96
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	enabled=$(uci -q get openclash-dns-guard.main.enabled 2>/dev/null)
	[ -z "$enabled" ] && enabled=1
	if [ "$enabled" != "1" ]; then
		echo "openclash-dns-guard: disabled via uci (enabled=$enabled)"
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/openclash-dns-guard.sh
	procd_set_param respawn 0 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "openclash-dns-guard"
}
